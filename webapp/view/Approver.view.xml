<mvc:View
    controllerName="com.emami.cqachecklist.zcqachecklist.controller.Approver"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true"
    xmlns:core="sap.ui.core"
>
    <Page
        id="ApproverPage"
        title="{i18n>title}"
    > 
     <!-- ✅ LOGOUT BUTTON IN PAGE HEADER -->
        <headerContent>
            <Button
                icon="sap-icon://log"
                text="Logout"
                press="onLogout"
                type="Reject" />
        </headerContent>
        <content>
        <IconTabBar>
                <items>
                    <IconTabFilter
                        icon="sap-icon://employee-approvals"
                        text="Approver"
                        iconColor="Positive"

                    >
                    <core:Fragment
                            fragmentName="com.emami.cqachecklist.zcqachecklist.view.fragments.SummaryDialog"
                            type="XML"
                        />
<Label
                            text="Checklist Number"
                            class="sapUiSmallMarginBegin sapUiSmallMarginTop textBold"
                            design="Bold"
                        />
                        <OverflowToolbar>
                            <Input
                                id="idChecklistNumber1"
                                placeholder="Select Checklist Number"
                                width="12rem"
                                valueHelpOnly="true"
                                showValueHelp="true"
                                valueHelpRequest="onValuehelpChecklistNumber"
                            />
                            <Button
                                press="onPressSearchApprover"
                                icon="sap-icon://search"
                            />
                            <Button
                                text="Clear"
                                press="onPressClear"
                                type="Emphasized"
                            />
                        </OverflowToolbar>
                        <core:Fragment
                            fragmentName="com.emami.cqachecklist.zcqachecklist.view.fragments.InputHeader"
                            type="XML"
                        />

                        <core:Fragment
                            fragmentName="com.emami.cqachecklist.zcqachecklist.view.fragments.Checklist"
                            type="XML"
                        />
                        <core:Fragment
                            fragmentName="com.emami.cqachecklist.zcqachecklist.view.fragments.Attachments"
                            type="XML"
                        />
                        
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
        <footer>
            <Bar>
                <contentMiddle>
                    <Button
                        type="Emphasized"
                        text="Approve"
                        press="onPressAccept"
                        visible="{jsonCentralModel>/Visible/ApproverAcceptBtn}"
                    />
                    <Button
                        text="Send Back to Site User"
                        type="Reject" press="onPressSendBackToReviewer"
                        visible="{jsonCentralModel>/Visible/SendBackToReviewerBtn}"
                    />
                </contentMiddle>
            </Bar>
        </footer>
    </Page>
</mvc:View>